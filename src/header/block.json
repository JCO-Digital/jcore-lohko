{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lohko/header",
	"version": "0.1.0",
	"title": "Header",
	"category": "design",
	"icon": "align-wide",
	"description": "Site header with an optional logo, a menu and free content.",
	"attributes": {
		"menuLocation": {
			"type": "string",
			"default": ""
		},
		"showLogo": {
			"type": "boolean",
			"default": true
		},
		"showChildren": {
			"type": "boolean",
			"default": false
		}
	},
	"example": {},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"textdomain": "lohko",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
