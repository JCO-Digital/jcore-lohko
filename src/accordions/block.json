{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lohko/accordions",
	"version": "0.1.0",
	"title": "Accordions",
	"category": "widgets",
	"icon": "text-page",
	"description": "Accordion items; one open at a time. Optionally the first item is open when the page loads. The Compact style has a smaller title and a thin chevron.",
	"attributes": {
		"firstOpen": {
			"type": "boolean",
			"default": false
		},
		"addStructuredData": {
			"type": "boolean",
			"default": false
		}
	},
	"example": {},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"color": {
			"background": true,
			"text": true
		},
		"interactivity": true
	},
	"textdomain": "lohko",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "compact",
			"label": "Compact"
		}
	]
}
