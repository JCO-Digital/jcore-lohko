{# Footer #}
<div {{ wrapper_attributes }}>
	{% for area in ['left', 'middle', 'right', 'bottom'] %}
		{% set area_menu = menu[ 'footer_' ~ area ] %}
		<section class="lohko-footer__section lohko-footer__{{ area }}">
			{{ jcore_global_content('footer-' ~ area) }}
			{% if area_menu %}
				{% include '@lohko/footer/partial/menu.twig' with {
					items: area_menu.get_items
				} only %}
			{% endif %}
		</section>
	{% endfor %}

	{% if copyrightShow %}
		<section class="lohko-footer__section lohko-footer__copyright">
			&copy; {{ copyrightText }} {{ copyright_year }}
		</section>
	{% endif %}
</div>
