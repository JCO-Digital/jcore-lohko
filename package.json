{
	"name": "lohko",
	"version": "1.1.1",
	"description": "Plugin with default block scaffolding for JCORE.",
	"author": "J&Co Digital <support@jco.fi>",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest --experimental-modules",
		"env:start": "pnpm dlx @wordpress/env start",
		"env:stop": "pnpm dlx @wordpress/env stop",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"make-json": "pnpm --package='@wp-blocks/make-pot@1.6.3' makejson build/ languages/",
		"make-pot": "pnpm dlx @wp-blocks/make-pot@1.6.3 . languages/",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --blocks-manifest --experimental-modules",
		"watch": "concurrently -c green --names ' blocks' 'pnpm start'"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/hooks": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/interactivity": "^8.1.0",
		"@wordpress/prettier-config": "^5.1.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/server-side-render": "^7.1.0",
		"concurrently": "^9.2.5"
	},
	"dependencies": {
		"@jcodigital/jcore-media": "^1.0.1",
		"@rive-app/canvas": "^2.51.0",
		"@rive-app/react-canvas": "^4.39.0"
	},
	"packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
	"pnpm": {
		"overrides": {
			"@babel/core@<7.29.6": "^7.29.6",
			"js-yaml@>=5 <5.4.1": "^5.4.1",
			"katex@<0.18.2": "^0.18.2",
			"minimatch@>=10 <11.0.1": "^11.0.1",
			"playwright@<1.55.1": "^1.55.1",
			"serialize-javascript@<7.1.3": "^7.1.3",
			"smol-toml@<1.9.0": "^1.9.0",
			"zod@<4.6.6": "^4.6.6"
		}
	}
}
